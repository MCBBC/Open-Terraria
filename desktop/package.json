{
  "name": "sandboxworld-desktop",
  "productName": "SandboxWorld",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SandboxWorld 桌面薄壳：加载现网 Cloudflare Pages 站点，补齐桌面窗口形态与运行时性能控制",
  "main": "main.mjs",
  "scripts": {
    "start": "electron .",
    "start:diag": "SW_DIAG=1 electron .",
    "pack:mac": "electron-builder --mac",
    "pack:win": "electron-builder --win",
    "pack:linux": "electron-builder --linux",
    "pack:dir": "electron-builder --dir",
    "size-gate": "node scripts/check-size.mjs"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  }
}
